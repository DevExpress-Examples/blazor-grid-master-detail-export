@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS

@using DevExpress.XtraReports.UI
@using GridMasterDetailExport.Data
@using GridMasterDetailExport.Reports

<DxGrid @ref="masterGrid"
        AllowColumnReorder="false"
        AllowSort="false"
        Data="DataProvider.GetUsers()"
        KeyFieldName="UserID">
    <ToolbarTemplate Context="ctx">
        <DxToolbar>
            <Items>
                <DxToolbarItem Text="Export as PDF"
                               Click='async() => await ExportTo(ExportFormat.PDF)' />
                <DxToolbarItem Text="Export as XLSX"
                               Click='async() => await ExportTo(ExportFormat.XLSX)' />
                <DxToolbarItem Text="Export as CSV"
                               Click='async() => await ExportTo(ExportFormat.CSV)' />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>
    <Columns>
        <DxGridDataColumn FieldName="UserID" />
        <DxGridDataColumn FieldName="UserName" />
    </Columns>
    <DetailRowTemplate Context="ctx">
        @{
            var user = ctx.DataItem as User;
            var userOrders =
            DataProvider.GetOrders().Where(o => o.UserID == user?.UserID);
        }
        <DxGrid @ref="detailGrid"
                AllowColumnReorder="false"
                AllowSort="false"
                Data="userOrders"
                KeyFieldName="OrderID">
            <Columns>
                <DxGridDataColumn FieldName="OrderID" />
                <DxGridDataColumn FieldName="OrderDate" />
                <DxGridDataColumn FieldName="ProductName" />
            </Columns>
        </DxGrid>
    </DetailRowTemplate>
</DxGrid>

@code {
    enum ExportFormat {
        PDF, XLSX, CSV
    }

    DxGrid? masterGrid;
    DxGrid? detailGrid;

    async Task ExportTo(ExportFormat format) {
        string fileName = "test";
        Stream exportStream;

        switch(format) {
            case ExportFormat.PDF:
                exportStream = GetExportStream((r, ms) => r.ExportToPdf(ms));
                fileName += ".pdf";
                break;
            case ExportFormat.XLSX:
                exportStream = GetExportStream((r, ms) => r.ExportToXlsx(ms));
                fileName += ".xlsx";
                break;
            case ExportFormat.CSV:
                exportStream = GetExportStream((r, ms) => r.ExportToCsv(ms));
                fileName += ".csv";
                break;
            default:
                throw new NotSupportedException(
                    "This Export Format is Not Supported");
        }

        exportStream.Position = 0;
        using var streamRef = new DotNetStreamReference(stream: exportStream);
        await JS.InvokeVoidAsync(
            "downloadFileFromStream", fileName, streamRef);
    }

    Stream GetExportStream(Action<XtraReport, Stream> exportAction) {
        GridState state = new() {
            MasterColumnNames = GetVisibleColumnNames(masterGrid).ToArray(),
            DetailColumnNames = GetVisibleColumnNames(detailGrid).ToArray(),
            RowExpandedStates = GetRowsExpandedStates()
        };
        using(var report = ReportGenerationHelpers.GetReportFromDxGrid(state)) {
            var ms = new MemoryStream();
            exportAction?.Invoke(report, ms);
            return ms;
        }
    }

    IEnumerable<string> GetVisibleColumnNames(IGrid? grid) {
        return grid?.GetVisibleColumns()
                    .OfType<DxGridDataColumn>()
                    .Select(c => c.FieldName ?? c.Name) ?? [];
    }

    Dictionary<string, bool> GetRowsExpandedStates() {
        Dictionary<string, bool> masterRowExpandedStates = new();
        for(int i = 0; i < masterGrid?.GetVisibleRowCount(); i++) {
            if(masterGrid.GetDataItem(i) is User user) {
                masterRowExpandedStates[user.UserID.ToString()]
                    = masterGrid.IsDetailRowExpanded(i);
            }
        }
        return masterRowExpandedStates;
    }
}